# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build

# test coverage (Module 26 §5: must never be committed)
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets; only .env.example is tracked
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# NOTE: next-env.d.ts is deliberately NOT ignored, despite being in Next's
# default template. It carries the `next/image-types/global` reference that
# declares the PNG module type used by the static logo import, and CI runs
# `typecheck` before `build`, so if the file is not committed the type check
# fails on a clean checkout with "Cannot find module '.../logo.png'". Next
# regenerates it with identical content, so tracking it produces no diff noise.

# vercel
.vercel

# claude code session artifacts (not part of the app)
*.jsonl
# Local tool permissions: machine-specific absolute paths, never shared
.claude/settings.local.json

# editor / OS local state (Module 26 §5: editor settings)
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
